#!/bin/bash
set -euo pipefail

# Generated by sonic-operator {{ shellQuote .SwitchName }}
{{ if .ConfigureONIE }}
# Configure ONIE install discovery for the next and every subsequent SONiC reboot.
mkdir -p /onieboot
cat >/etc/systemd/system/onieboot.mount <<'EOF'
[Unit]
Description=ONIE boot partition

[Mount]
What=LABEL=ONIE-BOOT
Where=/onieboot
Type=auto
Options=defaults

[Install]
WantedBy=multi-user.target
EOF

cat >/etc/systemd/system/sonic-operator-onie-install.service <<'EOF'
[Unit]
Description=Configure next boot for ONIE install discovery
Requires=onieboot.mount
After=onieboot.mount

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'grub-editenv /host/grub/grubenv set next_entry=ONIE'
ExecStart=/bin/sh -c 'grub-editenv /onieboot/grub/grubenv set onie_mode=install'

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now onieboot.mount
systemctl enable --now sonic-operator-onie-install.service
{{ end }}
config hostname {{ shellQuote .Hostname }}
config save -y
{{ if .Containers }}
# containers
{{ range .Containers }}if ! (
{{ if .InjectControlKubeconfig }}install -d -m 0700 /etc/sonic-operator/credentials &&
install -d -m 0700 {{ shellQuote (printf "/etc/sonic-operator/credentials/%s" .Name) }} &&
printf '%s' {{ shellQuote .EncodedControlKubeconfig }} | base64 -d >{{ shellQuote .ControlKubeconfigPath }} &&
chown {{ .DockerUser }} {{ shellQuote .ControlKubeconfigPath }} &&
chmod 0600 {{ shellQuote .ControlKubeconfigPath }} &&
{{ end }}docker pull {{ shellQuote .Image }} &&
(docker rm -f {{ shellQuote .Name }} >/dev/null 2>&1 || true) &&
docker run -d --name {{ shellQuote .Name }} --network host --restart unless-stopped{{ if .DockerUser }} --user {{ shellQuote .DockerUser }}{{ end }}{{ range .VolumeMounts }} -v {{ shellQuote . }}{{ end }}{{ if .InjectControlKubeconfig }} -e KUBECONFIG=/var/run/sonic-operator/control-kubeconfig -v {{ shellQuote (printf "%s:/var/run/sonic-operator/control-kubeconfig:ro" .ControlKubeconfigPath) }}{{ end }}{{ if .Entrypoint }} --entrypoint {{ shellQuote .Entrypoint }}{{ end }} {{ shellQuote .Image }}{{ range .Command }} {{ shellQuote . }}{{ end }}{{ range .Args }} {{ shellQuote . }}{{ end }}
); then
  echo {{ shellQuote .FailureMessage }} >&2
fi
{{ end }}{{ end }}sync
